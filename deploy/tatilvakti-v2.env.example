# /etc/tatilvakti-v2.env – Konfiguration für tatilvakti-v2.service und die Wartung.
# Anlegen (lesbar für root und den Dienstbenutzer, der Preflight liest sie mit):
#   sudo install -m 0640 -o root -g tatilvakti-v2 deploy/tatilvakti-v2.env.example /etc/tatilvakti-v2.env
# Format: systemd-EnvironmentFile, eine Zuweisung KEY=VALUE pro Zeile, Werte mit Leerzeichen in "…".
# TV_DB_PATH und TV_SALT_DB_PATH setzen die Units selbst (passend zu StateDirectory/RuntimeDirectory).
# Nach Änderungen: sudo systemctl restart tatilvakti-v2

# Öffentliche Adresse für Canonical, hreflang, Sitemap und Teilen-Links. Auch während der Tests
# auf der Test-Subdomain so lassen: Canonical zeigt dann auf die Hauptdomain (kein Doppel-Index).
TV_BASE_URL=https://tatilvakti.guenlab.de

# Anzahl vertrauenswürdiger Reverse-Proxys vor der App (Pangolin/Traefik: 1). Falsch gesetzt ist
# der Spam-Schutz entweder für alle gesperrt (0) oder per X-Forwarded-For fälschbar. Prüfen:
# docs/MIGRATION.md → Prüfliste nach dem Deploy.
TV_TRUST_PROXY=1

# Impressum (Pflicht vor dem Launch). Adresszeilen mit ; trennen. Leer = sichtbarer Hinweis
# auf der Info-Seite und imprint_ok=false in /healthz.
TV_OPERATOR_NAME=
TV_OPERATOR_ADDRESS=
TV_OPERATOR_EMAIL=

# Pfade alter Service-Worker-Skripte der Alt-App (kommagetrennt). Unter diesen Pfaden liefert die
# App einen Kill-Switch aus, der den alten Worker abmeldet. Erst setzen, wenn die App das
# unterstützt (folgt in einer späteren Phase) und der Pfad ermittelt ist (docs/MIGRATION.md).
#TV_LEGACY_SW_PATHS=/service-worker.js

# Optional, nur für die Umstiegsphase: Access-Log OHNE IP ins Journal (Methode, Pfad ohne Query,
# Status, Dauer), um 404 alter URLs zu finden. Danach wieder auskommentieren.
#GUNICORN_CMD_ARGS="--access-logfile - --access-logformat '%(m)s %(U)s %(s)s %(L)ss'"
