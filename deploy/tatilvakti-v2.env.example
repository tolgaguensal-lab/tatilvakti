# /etc/tatilvakti-v2.env – Konfiguration für tatilvakti-v2.service und die Wartung.
# Anlegen (lesbar für root und den Dienstbenutzer, der Preflight liest sie mit):
#   sudo install -m 0640 -o root -g tatilvakti-v2 deploy/tatilvakti-v2.env.example /etc/tatilvakti-v2.env
# Format: systemd-EnvironmentFile, eine Zuweisung KEY=VALUE pro Zeile, Werte mit Leerzeichen in "…".
# TV_DB_PATH und TV_SALT_DB_PATH setzen die Units selbst (passend zu StateDirectory/RuntimeDirectory).
# Nach Änderungen: sudo systemctl restart tatilvakti-v2

# Öffentliche Adresse für Canonical, hreflang, Sitemap und Teilen-Links. Auch während der Tests
# auf der Test-Subdomain so lassen: Canonical zeigt dann auf die Hauptdomain (kein Doppel-Index).
TV_BASE_URL=https://tatilvakti.guenlab.de

# Anzahl vertrauenswürdiger Reverse-Proxys vor der App (Pangolin/Traefik: 1). Falsch gesetzt ist
# der Spam-Schutz entweder für alle gesperrt (0) oder per X-Forwarded-For fälschbar. Prüfen:
# docs/MIGRATION.md → Prüfliste nach dem Deploy.
TV_TRUST_PROXY=1

# Impressum (Pflicht vor dem Launch). Adresszeilen mit ; trennen. Leer = sichtbarer Hinweis
# auf der Info-Seite und imprint_ok=false in /healthz. Fehlt eine der drei Angaben, zählt das wie
# leer: Ein halbes Impressum zeigt die App nie.
TV_OPERATOR_NAME=
TV_OPERATOR_ADDRESS=
TV_OPERATOR_EMAIL=

# Datenschutztext: Empfänger und Frist des Proxy-Logs (Pflicht vor dem Launch, docs/MIGRATION.md 2.6).
# Leer oder ungültig = auf der Info-Seite steht, dass die Angaben folgen, /healthz meldet
# privacy_ok=false und "privacy" unter attention, der Preflight warnt.
# Name und Sitz des Hosting-Anbieters, der als Auftragsverarbeiter arbeitet (AVV liegt vor), so wie
# er im Text stehen soll, z. B. "Beispiel Hosting GmbH, Musterstadt". Laufen Server und Proxy bei
# verschiedenen Anbietern, beide mit ; getrennt. Steht wörtlich im deutschen und im türkischen Text,
# also ohne Zusätze in nur einer Sprache. Sitzt ein Anbieter außerhalb der EU, reicht das nicht
# (Drittlandübermittlung): dann den Text in de.json und tr.json ergänzen.
TV_HOSTING_PROVIDER=
# So viele Tage bewahrt der vorgeschaltete Proxy sein Protokoll der Anfragen samt IP-Adresse auf
# (Pangolin: Aufbewahrung der Request-Logs in den Organisationseinstellungen; dazu Traefik-accessLog).
# Ganze Zahl. 0 = es gibt kein solches Protokoll (Aufbewahrung abgeschaltet und accessLog aus oder
# ohne ClientHost/ClientAddr). Wird die Einstellung im Proxy geändert, hier nachziehen.
TV_PROXY_LOG_DAYS=

# Pfade alter Service-Worker-Skripte der Alt-App (kommagetrennt). Unter diesen Pfaden liefert die
# App einen Kill-Switch aus: meldet den alten Worker ab, löscht alle Caches außer tv2-*. Setzen, sobald
# der Pfad ermittelt ist (docs/MIGRATION.md, Abschnitt 3). Ungültige Pfade verhindern den Start.
#TV_LEGACY_SW_PATHS=/service-worker.js

# Optional, nur für die Umstiegsphase: Access-Log OHNE IP ins Journal (Methode, Pfad ohne Query,
# Status, Dauer), um 404 alter URLs zu finden. Danach wieder auskommentieren.
#GUNICORN_CMD_ARGS="--access-logfile - --access-logformat '%(m)s %(U)s %(s)s %(L)ss'"
