# Beispiel-Unit für einen kleinen VPS. Pfade/Benutzer anpassen, dann:
#   sudo cp deploy/tatilvakti.service /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable --now tatilvakti
[Unit]
Description=tatilvakti (Flask/gunicorn)
After=network.target

[Service]
User=tatilvakti
Group=tatilvakti
WorkingDirectory=/opt/tatilvakti
Environment=TV_DB_PATH=/var/lib/tatilvakti/tatilvakti.db
Environment=TV_BASE_URL=https://tatilvakti.example
# Anzahl vertrauenswürdiger Reverse-Proxys vor der App (für die echte Client-IP beim Spam-Schutz)
Environment=TV_TRUST_PROXY=1
EnvironmentFile=-/etc/tatilvakti.env
# Kein Access-Log: die App selbst speichert keine IPs, das Log soll es auch nicht tun
ExecStart=/opt/tatilvakti/.venv/bin/gunicorn --workers 2 --threads 4 --bind 127.0.0.1:3095 wsgi:app
Restart=always
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/tatilvakti

[Install]
WantedBy=multi-user.target
